FROM tiangolo/nginx-rtmp:latest

# Copy nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Create necessary directories
RUN mkdir -p /var/hls /var/recordings /var/www

# Copy static files
COPY www/ /var/www/

# Set permissions
RUN chmod -R 755 /var/hls /var/recordings /var/www

EXPOSE 1935 8080

CMD ["nginx", "-g", "daemon off;"]